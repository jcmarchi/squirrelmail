# DevBox runtime state (Docker volumes, not tracked)
# docker-compose managed volumes are ephemeral

# SquirrelMail generated config (created by Docker bind mount)
config/config.php

# Generated local file (public DevBox-only fixture credentials, not secrets)
docker/dovecot/users.passwd

# SquirrelMail user data (should not be committed)
data/
attach/

# Environment files with secrets
.env
.env.local
.env.*.local

# Editor files
*.swp
*.swo
*~
.vscode/

# OS files
.DS_Store
Thumbs.db

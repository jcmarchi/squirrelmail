# DEVBOX project profile example.
# Copy/adapt into a project-specific non-secret profile or deployment document.
# Do not commit real secrets.

PROJECT_DOMAIN=<PROJECT_DOMAIN>
SLUG=<SLUG>
DOMAIN=<DOMAIN>
SUBDOMAIN=
PUBLIC_HOST=<SLUG>.<DOMAIN>

COMPOSE_PROJECT_NAME=<SLUG>_main
PORT_BLOCK=<PORT_BLOCK>
APP_PORT=<APP_PORT>
API_PORT=<API_PORT>
UI_PORT=<UI_PORT>

PUBLIC_SERVICE=app
PUBLIC_INTERNAL_PORT=80

HEALTH_PATH=/health
API_HEALTH_PATH=/api/v1/health

DEVBOX_UID=1000
DEVBOX_GID=1000

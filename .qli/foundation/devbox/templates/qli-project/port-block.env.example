# QLi DevBox port block assignment
# Schema version: 1
# Project: <PROJECT_SLUG>
# Port block ID: <PORT_BLOCK_ID>
# Assigned: <DATE>
#
# Copy this file to .qli/project/port-block.env in the managed project.
# Replace all <PLACEHOLDER> values before use.
# This file is safe to commit to private project repositories.
# Review before committing if the project repository is public-facing.
#
# All ports are DevBox-assigned and local-only (127.0.0.1 bindings).
# Do NOT use project-native default ports here. Use DevBox-assigned values only.
# Leave unused port lines blank (commented). Do not remove them.
# QLI_BIND_HOST must remain 127.0.0.1 unless explicitly approved and documented.

QLI_PROJECT_SLUG=<PROJECT_SLUG>
# Must match manifest.yml:project_slug.

QLI_PORT_BLOCK_ID=<PORT_BLOCK_ID>
# Must match manifest.yml:assigned_port_block_id.

QLI_APP_PORT=<APP_PORT>
# Host-side port for the primary application container.
# Bind target in Compose: 127.0.0.1:${QLI_APP_PORT}:<CONTAINER_PORT>

# QLI_API_PORT=<API_PORT>
# Host-side port for the API service container, if separate from the app.
# Leave commented if not applicable.

# QLI_DB_PORT=<DB_PORT>
# Host-side port for the database container.
# WARNING: Must bind to 127.0.0.1 only. Never 0.0.0.0.
# Leave commented if no database port is exposed to the host.

# QLI_AUX_PORT_1=
# Auxiliary port 1. Leave commented if not applicable.

# QLI_AUX_PORT_2=
# Auxiliary port 2. Leave commented if not applicable.

QLI_BIND_HOST=127.0.0.1
# Host binding address. Must remain 127.0.0.1 unless the DevBox operator
# explicitly approves and documents an alternative.
